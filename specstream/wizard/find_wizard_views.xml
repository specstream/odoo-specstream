<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="specstream_find_wizard_form" model="ir.ui.view">
        <field name="name">specstream.find.wizard.form</field>
        <field name="model">specstream.find.wizard</field>
        <field name="arch" type="xml">
            <form string="Find rows">
                <field name="state" invisible="1"/>
                <field name="quote_id" invisible="1"/>
                <field name="quote_hash" invisible="1"/>
                <field name="maximum_cents" invisible="1"/>
                <group>
                    <field name="request" readonly="state != 'draft'"/>
                    <field name="count" readonly="state != 'draft'"/>
                    <field name="read_as" invisible="state == 'draft'"/>
                    <field name="price" invisible="state == 'draft'"/>
                    <field name="find_id" invisible="state != 'started'"/>
                    <field name="status" invisible="state != 'started'"/>
                    <field name="max_rows" invisible="state != 'started'"/>
                </group>
                <footer>
                    <button string="Get the price" name="action_quote" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Approve and start" name="action_start" type="object" class="btn-primary"
                            invisible="state != 'quoted'"/>
                    <button string="Refresh" name="action_refresh" type="object"
                            invisible="state != 'started'"/>
                    <button string="Create leads" name="action_create_leads" type="object" class="btn-primary"
                            invisible="state != 'started'"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="specstream_find_wizard_action" model="ir.actions.act_window">
        <field name="name">Find rows</field>
        <field name="res_model">specstream.find.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="specstream_find_menu" name="Find rows (SpecStream)"
              parent="crm.crm_menu_sales" action="specstream_find_wizard_action" sequence="90"/>
</odoo>
